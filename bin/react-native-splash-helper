#!/usr/bin/env node

const generateSplash = require('../scripts/generateSplash');

const args = process.argv.slice(2);

// Allow both `react-native-splash-helper` and `... generate-splash`
const filtered = args[0] === 'generate-splash' ? args.slice(1) : args;

generateSplash(undefined, filtered).then(() => {
  if (process.exitCode && process.exitCode !== 0) {
    process.exit(process.exitCode);
  }
});
